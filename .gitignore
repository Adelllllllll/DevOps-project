# ❌ Dossiers temporaires et caches
__pycache__/
*.py[cod]
*.log
*.tmp
*.DS_Store
*.swp

# Ignore tous les joblib sauf ceux du modèle
*.joblib
!data/processed/model.joblib
!data/processed/tfidf_vectorizer.joblib
!data/processed/category_encoder.joblib
!data/processed/rating_scaler.joblib


# ✅ Ignore les données sauf les traces DVC
data/*
!data/raw/.gitignore
!data/raw/*.dvc

# ❌ Dossiers générés par MLflow
mlruns/
mlartifacts/

# ❌ Cache de tests Pytest
.pytest_cache/

# ❌ Fichiers spécifiques à l'environnement local
.env
.env.*

# ❌ Conda et pip env files inutiles
*.yml
*.yaml
!requirements.txt
